---
import HrLayout from "../../../components/HrLayout.astro";
import { roles, stages } from "../../../fixtures";
const role = roles.find(r => r.id === Astro.params.id);
if (!role) return new Response("Role not found", { status: 404 });
---
<HrLayout title={role.title} description={`${role.department} · Hiring progress`}>
<div class="toolbar"><a href="/roles">← Roles</a><div class="actions"><a href={`/screeners/${role.id}`}>Screener</a><a class="button secondary" href={`/roles/${role.id}/builder`}>Open role builder</a></div></div>
<section class="paper"><div class="toolbar"><span><span class="tag green">{role.status}</span> <span class="tag">{role.priority} priority</span></span><a href="/plan">On the hiring plan →</a></div><form class="local-form role-meta"><label>Status<select aria-label="Status" name="status"><option selected={role.status === "Open"}>Open</option><option selected={role.status === "Approved"}>Approved</option><option selected={role.status === "Planned"}>Planned</option><option>On hold</option><option>Closed</option></select></label><label>Priority<select aria-label="Priority" name="priority"><option selected={role.priority === "High"}>High</option><option selected={role.priority === "Medium"}>Medium</option><option>Low</option></select></label><label>Hiring manager<select aria-label="Hiring manager" name="manager">{[role.manager, ...["Alex Morgan", "Riley Chen", "Sam Rivera"].filter(n => n !== role.manager)].map(n => <option>{n}</option>)}</select></label><label>Owner (email)<input name="owner" type="email" value={`${role.owner.toLowerCase()}@example.com`} /></label><button>Save</button></form></section>
<div class="metrics three"><article class="paper"><h2>Days open</h2><strong>{role.days}</strong><small>Since opening</small></article><article class="paper"><h2>In process</h2><strong>{role.process}</strong><small>{role.review} awaiting review · {role.offer} at offer</small></article><article class="paper"><h2>Likely to hire</h2><strong class="date">{role.target}</strong><small>Forecast</small></article></div>
<section class="paper"><h2>Funnel for this role (all-time)</h2><div role="region" class="scroll-table" tabindex="0" aria-label="Role data"><table><thead><tr><th>Stage</th><th>Went through / moved on</th><th>Pass-through</th><th>There now</th></tr></thead><tbody>{stages.map((stage,i) => <tr><td>{stage}</td><td><progress value={role.process ? Math.max(1, 12-i*2) : 0} max="20" aria-label={`${stage} movement`}></progress></td><td>{role.process ? `${70-i*5}%` : "No data"}</td><td>{i===0 ? role.process : 0}</td></tr>)}</tbody></table></div></section>
<section class="paper"><h2>Stage map</h2><p class="caption">Map the interview stages to the scorecard before opening the role.</p><ol class="stage-map">{stages.map(stage => <li><strong>{stage}</strong><span>Hiring team</span></li>)}</ol><a href={`/roles/${role.id}/builder?step=interviews`}>View the interview loop →</a></section>
</HrLayout>
