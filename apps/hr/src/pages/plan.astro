---
import HrLayout from "../components/HrLayout.astro";
import { roles } from "../fixtures";
---
<HrLayout title="Hiring plan" description="Every planned role, and where each one stands today.">
<div class="toolbar"><div class="filter-buttons"><button type="button" data-plan-filter="all" aria-pressed="true">Company plan · {roles.length}</button><button type="button" data-plan-filter="mine" class="secondary" aria-pressed="false">My roles · {roles.filter(r=>r.owner === "Alex").length}</button></div><a class="button secondary" href="/roles#role-request">+ Add a role</a></div>
<div class="metrics"><article class="paper"><h2>Planned hires · next 6 months</h2><strong>6</strong><small>Target dates from October 2026</small></article><article class="paper"><h2>Planned hires · next 3 months</h2><strong>5</strong><small>2 open now, 3 approved</small></article><article class="paper"><h2>Requested · pending approval</h2><strong>0</strong><small>Nothing waiting in the plan</small></article><article class="paper"><h2>Open roles</h2><strong>9</strong><small>7 past target hire date</small></article></div>
<div class="toolbar"><span class="caption" id="plan-range">Aug 2026 to Jan 2027</span><div class="actions"><button class="secondary" data-plan-month="-1">‹ Earlier</button><button class="secondary" data-plan-month="0">Today</button><button class="secondary" data-plan-month="1">Later ›</button></div></div>
<section class="paper plan-paper"><div role="region" class="scroll-table" tabindex="0" aria-label="Hiring timeline"><table class="plan-table"><thead><tr><th>Hiring manager · role</th><th>Status</th><th class="month">Aug</th><th class="month">Sep</th><th class="month">Oct</th><th class="month">Nov</th><th class="month">Dec</th><th class="month">Jan</th><th>Next step</th><th><span class="sr-only">View</span></th></tr></thead>{["In progress", "Upcoming"].map(group => <tbody><tr class="group-row"><th colspan="10">{group} <small>· {group === "In progress" ? "Sorted by target hire date" : "Sorted by slated start"}</small></th></tr>{roles.filter(r => (r.status === "Open") === (group === "In progress")).sort((a,b)=>a.target.localeCompare(b.target)).map(r=><tr data-plan-row data-owner={r.owner}><td><a href={`/roles/${r.id}`}>{r.title}</a><small>{r.manager} · {r.department} · hire by {r.target}</small></td><td><span class="tag green">{r.status}</span></td><td colspan="6" class="timeline-cell" data-target={r.target}><div class="timeline-grid"><span class="timeline-bar"></span></div></td><td class="next-action">{r.next}</td><td><a aria-label={`View ${r.title}`} href={`/roles/${r.id}/builder`}>✎</a></td></tr>)}</tbody>)}</table></div></section>
<p class="caption">My roles shows Alex Morgan's assignments.</p>
</HrLayout>
