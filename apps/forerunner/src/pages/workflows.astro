---
import ForerunnerLayout from "../components/ForerunnerLayout.astro";

// Everything that runs for the member: what is running now, then Forerunner's
// daily discovery and their routines, each with Run now, Pause or Resume and
// Delete, then the daily run's suggestions: a workflow to turn on, a change to a
// routine, or an app. The page runs the documents agents run over MCP.
---
<ForerunnerLayout title="Workflows" description="What runs for you, what is running now, and what to add next." page="workflows">
  <div id="workflows-page" data-page="workflows">
    <p id="workflows-error" role="alert" hidden></p>
    <section aria-labelledby="workflows-running-heading" class="forerunner-section workflows-section" id="workflows-running-section" hidden>
      <h2 id="workflows-running-heading" class="source-section-heading">Running now</h2>
      <div id="workflows-running" class="paper source-list"></div>
    </section>
    <section aria-labelledby="workflows-list-heading" class="forerunner-section workflows-section">
      <h2 id="workflows-list-heading" class="source-section-heading">Your workflows</h2>
      <div class="paper workflows-table">
        <table aria-labelledby="workflows-list-heading">
          <thead><tr><th scope="col">Workflow</th><th scope="col">Runs</th><th scope="col">Last result</th><th scope="col">Next run</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody id="workflows-list"><tr><td colspan="5"><p role="status">Loading workflows…</p></td></tr></tbody>
        </table>
      </div>
    </section>
    <section aria-labelledby="workflows-suggestions-heading" class="forerunner-section workflows-section" id="suggestions" hidden>
      <h2 id="workflows-suggestions-heading" class="source-section-heading">Suggestions</h2>
      <div id="workflows-suggestions" class="paper source-list"></div>
    </section>
  </div>
</ForerunnerLayout>
<script>import "../scripts/workflows";</script>
