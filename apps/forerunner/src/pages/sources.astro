---
import ForerunnerLayout from "../components/ForerunnerLayout.astro";

// Where discovery looks, and a rerun per connected account. Reruns use the
// discovery run, one source at a time, and land on the run's
// results page. Discovery reads Gmail, Google Calendar, GitHub and Slack;
// iMessage and Apple Health are listed as coming soon.
const operational = import.meta.env.OUTFITTER_APP_MODE === "operational";
---
<ForerunnerLayout title="Sources" description="Where Forerunner looks. Rerun a source any time; what it finds goes to your knowledge graph for review." page="sources">
  <div id="sources-page" data-page="sources-list">
    <p id="sources-error" role="alert" hidden></p>
    <section class="paper source-list" aria-label="Connected sources">
      <div id="sources-connected">{operational ? <p role="status">Loading sources…</p> : <p class="muted">This demo does not connect accounts or run discovery.</p>}</div>
    </section>
    <section class="paper source-list" aria-label="Not connected yet">
      {[["github", "H", "GitHub", "Issues and pull requests you are involved in."], ["slack", "S", "Slack", "Public channels you choose."]].map(([provider, letter, name, note]) => (
        <div class="source-row source-row--soon" data-connect={provider}><span class={`source-logo source-logo--${provider}`} aria-hidden="true">{letter}</span><div class="source-text"><strong>{name}</strong><span class="muted">{note} Connect it in <a href="./settings">Settings</a>.</span></div></div>
      ))}
      {[["M", "iMessage", "Coming soon. Needs the Mac helper."], ["H", "Apple Health", "Coming soon. Import an export.xml for now."]].map(([letter, name, note]) => (
        <div class="source-row source-row--soon"><span class="source-logo" aria-hidden="true">{letter}</span><div class="source-text"><strong>{name}</strong><span class="muted">{note}</span></div></div>
      ))}
    </section>
    {operational ? <section aria-labelledby="recent-runs-heading">
      <h2 id="recent-runs-heading" class="source-section-heading">Recent runs</h2>
      <div id="sources-runs" class="paper source-list"><p role="status">Loading runs…</p></div>
    </section> : null}
  </div>
</ForerunnerLayout>
<script>import "../scripts/sources";</script>
