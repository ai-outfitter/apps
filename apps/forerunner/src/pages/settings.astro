---
import ForerunnerLayout from "../components/ForerunnerLayout.astro";

// One flat page: the daily run, the accounts it can read, and sources still to
// connect. Reruns live on Sources. Signing up with Google connects Gmail and
// Calendar, and the daily run turns itself on for Gmail (else Calendar) the
// first time this page or Sources loads; the script fills the rows below.
const operational = import.meta.env.OUTFITTER_APP_MODE === "operational";
const soon = [["M", "iMessage", "Coming soon. Needs the Mac helper."], ["H", "Apple Health", "Coming soon. Import an export.xml for now."]];
// GitHub and Slack connect in the platform, which returns here; each row hides once it is connected.
const more = [
  ["github", "H", "GitHub", "Issues and pull requests you are involved in.", "/plugins/github", "Connect GitHub"],
  ["slack", "S", "Slack", "Public channels you choose, with their threads.", "/connectors/slack", "Connect Slack"],
];
---
<ForerunnerLayout title="Settings" description="Forerunner runs discovery every morning on your connected accounts." page="settings">
  <div id="settings-page" data-page="settings">
    <p id="settings-error" role="alert" hidden></p>
    <div role="region" aria-labelledby="daily-heading">
      <h2 id="daily-heading" class="source-section-heading">Daily discovery</h2>
      <div class="paper source-list">
        <div class="source-row settings-daily">
          <div class="source-text">
            <div class="source-heading"><strong>Every morning</strong><span id="settings-daily-pill" class="source-pill">{operational ? "Checking" : "Demo"}</span></div>
            <span id="settings-daily-status" class="muted" role="status">{operational ? "Loading…" : "This demo does not connect accounts or run discovery."}</span>
            <span class="muted">The daily run reads one account. Rerun the others any time from <a href="./sources">Sources</a>.</span>
          </div>
          <label class="settings-switch"><input id="settings-daily" type="checkbox" role="switch" disabled /> <span>Run daily</span></label>
          <label id="settings-daily-account" class="settings-account" hidden>Account it reads <select id="settings-daily-source"></select></label>
        </div>
      </div>
    </div>
    <div role="region" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="source-section-heading">Sources</h2>
      <div id="settings-sources" class="paper source-list">{operational ? <p class="source-row muted" role="status">Loading sources…</p> : <p class="source-row muted">No accounts in this demo.</p>}</div>
    </div>
    <div role="region" aria-labelledby="connect-heading">
      <h2 id="connect-heading" class="source-section-heading">Connect more sources</h2>
      <div class="paper source-list">
        <div id="settings-google" class="source-row" hidden={operational}>
          <span class="source-logo source-logo--gmail" aria-hidden="true">G</span>
          <div class="source-text"><strong>Google</strong><span id="settings-google-detail" class="muted">Gmail and Google Calendar, for the daily run.</span></div>
          {operational ? <a id="settings-google-connect" class="ui-button" href="/connectors/google">Connect Google</a> : <button class="ui-button" type="button" disabled>Connect Google</button>}
        </div>
        {more.map(([provider, letter, name, note, href, action]) => (
          <div class="source-row" data-connect={provider} hidden={operational}>
            <span class={`source-logo source-logo--${provider}`} aria-hidden="true">{letter}</span>
            <div class="source-text"><strong>{name}</strong><span class="muted">{note}</span></div>
            {operational ? <a class="ui-button ui-button--secondary" href={href}>{action}</a> : <button class="ui-button ui-button--secondary" type="button" disabled>{action}</button>}
          </div>
        ))}
        {soon.map(([letter, name, note]) => (
          <div class="source-row source-row--soon"><span class="source-logo" aria-hidden="true">{letter}</span><div class="source-text"><strong>{name}</strong><span class="muted">{note}</span></div></div>
        ))}
      </div>
    </div>
  </div>
</ForerunnerLayout>
<script>import "../scripts/settings";</script>
