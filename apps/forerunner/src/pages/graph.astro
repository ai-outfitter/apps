---
import ForerunnerLayout from "../components/ForerunnerLayout.astro";
import { rootHref } from "../root-href";

// The index of everything discovery has added to the knowledge graph. Each
// row links to the record in the Wiki; the Sources page reruns a connector.
const operational = import.meta.env.OUTFITTER_APP_MODE === "operational";
const root = rootHref(Astro.url.pathname, 1);
---
<ForerunnerLayout title="Knowledge graph" description="People, places, events, goals and the evidence behind them, found by discovery or added by you." page="graph">
  <a slot="intro-actions" class="ui-button ui-button--secondary" href={`${root}sources`}>Sources and reruns</a>
  <div id="entities-page" data-page="entities">
    <p id="entities-summary" class="entities-summary" role="status">{operational ? "Loading your knowledge graph…" : "This demo does not run discovery, so nothing has been added yet."}</p>
    <p id="entities-error" role="alert" hidden></p>
    {operational ? <>
      <div class="entities-controls">
        <label class="visually-hidden" for="entities-search">Search</label>
        <input id="entities-search" type="search" placeholder="Search people, places, goals…" autocomplete="off" />
        <div id="entities-status" class="entities-switch" role="group" aria-label="Status"></div>
      </div>
      <nav id="entities-types" class="entities-chips" aria-label="Filter by type"></nav>
      <section class="paper entities-table" aria-label="Entities">
        <table>
          <thead><tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Found in</th><th scope="col">Links</th><th scope="col">Added</th><th scope="col">Status</th></tr></thead>
          <tbody id="entities-rows"></tbody>
        </table>
        <p id="entities-empty" class="muted" hidden>Nothing matches. Try another search or type.</p>
      </section>
      <p id="entities-shown" class="muted"></p>
    </> : null}
  </div>
</ForerunnerLayout>
<script>import "../scripts/entities";</script>
