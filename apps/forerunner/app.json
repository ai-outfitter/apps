{
  "id": "outfitter/forerunner",
  "version": "0.1.1",
  "runtime": "cloudflare-workers-for-platforms",
  "dataLocation": "installation-database",
  "modes": {
    "demo": {
      "capabilities": []
    },
    "operational": {
      "capabilities": [
        "data.export",
        "api.serve",
        "home-cards.publish",
        "workflow.host",
        "threads.use",
        "threads.provide",
        "entities.read",
        "actions.invoke",
        "connector.gmail.messages.list",
        "connector.gmail.messages.get",
        "connector.google-calendar.events.list",
        "connector.github.activity.read",
        "connector.slack.channels.selected",
        "connector.slack.history.read",
