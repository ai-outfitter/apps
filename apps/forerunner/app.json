  "catalog": {
    "access": "public",
    "demo": {
      "slug": "forerunner",
      "name": "Forerunner",
      "description": "See how a foreman keeps your priorities moving."
    },
    "operational": {
      "slug": "forerunner",
      "name": "Forerunner",
      "description": "Privately manage your stones, pebbles and sand by hand."
    },
    "sections": [
      {
        "label": "Today",
        "path": ""
      },
      {
        "label": "Life",
        "path": "life"
      },
      {
        "label": "Home",
        "path": "home"
      },
      {
        "label": "People",
        "path": "people"
      },
      {
        "label": "Money",
        "path": "money"
      },
      {
        "label": "Body",
        "path": "body"
      },
      {
        "label": "Progress",
        "path": "progress"
      }
    ],
    "presentation": {
      "outcome": "Keep your highest priorities moving with a private board of stones, pebbles and sand.",
      "connectors": [
        "Gmail · unavailable",
        "Google Calendar · unavailable"
      ],
      "steps": [
        [
          "Rank the stones",
          "Create your highest-priority tickets and move them into the order you want to work."
        ],
        [
          "Break work into pebbles",
          "Add the next actions that move each stone forward."
        ],
        [
          "Capture the sand",
          "Keep small tasks on their own or link them to a stone."
        ],
        [
          "Keep your board current",
          "Edit notes and due dates, complete work, and reopen it when needed."
        ]
      ],
      "access": "Private manual board. Each member creates and ranks their own stones, pebbles and sand. Demo records are synthetic; no mail or calendar is read and no model runs."
    },
    "cover": "catalog/cover.png"
  },
  "dependencies": [
    "onto"
  ]
}
