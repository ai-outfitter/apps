{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schemas": [
          {
            "name": "forerunner",
            "schema": "./graph/schema.graphql",
            "tadaOutputLocation": "./graph/graphql-env.d.ts"
          }
        ]
      }
    ]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "fixtures/*.json",
    "navigation.js",
    "../../packages/ui/src/astro/**/*.astro",
    "tests/**/*",
    "scripts/**/*",
    "playwright.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
