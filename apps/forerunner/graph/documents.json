  {
    "name": "SuggestionChanges",
    "kind": "mutation",
    "story": "As an authorized caller, I want to act on the daily run's suggestions: update one to applied (turn a workflow on or rewrite its routine) or dismissed (set it aside). Read Suggestions for the ids, so that each change has a durable receipt and explicit next steps.",
    "query": "mutation SuggestionChanges($input: SuggestionChangesInput!) {\n  suggestionChanges(input: $input) {\n    items {\n      key\n      status\n      result\n      error\n    }\n    instructions {\n      code\n      itemKey\n      actor\n      required\n      message\n      call\n      taskId\n      url\n    }\n  }\n}",
    "hash": "4001b82c3832d68ce2cbb6a410fc9490b1188fef10cf6b456a01d04c8ff1aa52",
    "variables": {
      "type": "object",
      "properties": {
        "input": {
          "description": "GraphQL SuggestionChangesInput!"
        }
      },
      "required": [
        "input"
      ]
    },
    "mcp": {
      "description": "Act on suggestions from Suggestions with action update and a status: applied turns a workflow on or rewrites the routine it changes, dismissed sets it aside. An app suggestion is built from Apps, so it can only be dismissed here."
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "input": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "items": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "description": "Your stable key for this item: any short name, such as add-ada. Reuse it only to retry the same input."
                      },
                      "action": {
                        "type": "string",
                        "const": "update"
                      },
                      "input": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "applied",
                              "dismissed"
                            ]
                          },
                          "timezone": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          }
                        },
                        "required": [
                          "id",
                          "status"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "key",
                      "action",
                      "input"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "suggestionChanges": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "result": {
                    "description": "JSON",
                    "nullable": true
                  },
                  "error": {
                    "description": "JSON",
                    "nullable": true
                  }
                }
              }
            },
            "instructions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "itemKey": {
                    "type": "string"
                  },
                  "actor": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string"
                  },
                  "call": {
                    "description": "JSON",
                    "nullable": true
                  },
                  "taskId": {
                    "type": "string",
                    "nullable": true
                  },
                  "url": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          },
          "nullable": true
        }
      }
    }
  },
