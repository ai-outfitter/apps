---
import AppLayout from '@ai-outfitter/ui/astro/ManagedAppLayout.astro';
import {appHref} from '../app-href';
const {title,description='Review work created by your agent.'}=Astro.props;
const links=[{label:'Decks and artifacts',href:appHref(Astro.url.pathname,'/artifacts'),active:Astro.url.pathname.startsWith('/artifacts')},{label:'Creative records',href:appHref(Astro.url.pathname,'/creative'),active:Astro.url.pathname.startsWith('/creative')}];
---
<AppLayout name="Presentations" active="home" {title} {description} sidebarLinks={links}><slot name="intro-actions" slot="intro-actions"/><slot/></AppLayout>
