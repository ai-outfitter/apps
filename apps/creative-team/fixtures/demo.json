    {
      "id": "audience.person",
      "answer": "Priya, a night-shift ICU nurse six years in, who loves the work but is running on caffeine and dread.",
      "revision": 1,
      "updatedBy": "demo-member",
      "updatedAt": 1793900000000
    },
    {
      "id": "audience.bad-day",
      "answer": "Three admissions before midnight, no break, charting until 8:30, then lying awake at noon replaying everything.",
      "revision": 1,
      "updatedBy": "demo-member",
      "updatedAt": 1793900000000
    },
    {
      "id": "audience.complaint",
      "answer": "\"I'm not tired, I'm empty. I don't know who I am outside of a shift.\"",
      "revision": 1,
      "updatedBy": "demo-member",
      "updatedAt": 1793900000000
    },
    {
      "id": "audience.tried",
      "answer": "Meditation apps, switching units, a wellness committee that met twice.",
      "revision": 1,
      "updatedBy": "demo-member",
      "updatedAt": 1793900000000
    },
    {
      "id": "story.lived",
      "answer": "Eight years as an ER nurse, two of them burnt out enough that I nearly left medicine.",
      "revision": 1,
      "updatedBy": "demo-member",
      "updatedAt": 1793900000000
    },
    {
      "id": "story.turn",
      "answer": "A patient's daughter asked how I was, and I couldn't answer. That night I wrote down what a good shift felt like.",
      "revision": 1,
      "updatedBy": "demo-member",
      "updatedAt": 1793900000000
    },
    {
      "id": "pillars.hours",
      "answer": "Burnout, sleep, shift work, small habits, nursing culture, coaching, Stoicism.",
