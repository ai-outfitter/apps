{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rootTypes": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "relationships": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "direction": {
                    "default": "outgoing",
                    "type": "string",
                    "enum": [
                      "outgoing",
                      "incoming"
                    ]
                  },
                  "from_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "to_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "relationships",
        "maxDepth",
        "maxNodes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "purpose",
    "rootTypes",
    "selection"
  ],
  "additionalProperties": false
}
