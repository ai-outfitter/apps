---
import Layout from "./Layout.astro";
interface Props {
  view?: "overview" | "connections" | "graphs" | "org-chart";
  routeDepth?: number;
}
const { view = "overview", routeDepth = 2 } = Astro.props;
const { nodeType, nodeId, graphId } = Astro.params;
---
<Layout title="Entity" description="Shared context for humans and agents." page="page" {routeDepth}>
  <div id="graph" class="wiki-map" aria-busy="true" data-node-type={nodeType} data-node-id={nodeId} data-view={view} data-graph-id={graphId}></div>
</Layout>
<script>import "../scripts/graph.ts";</script>
