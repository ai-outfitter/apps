[
  {
    "name": "BatchSubmission",
    "kind": "query",
    "story": "As a reviewer, I want to inspect exactly which proposals were submitted in a particular version, so that I can compare edits before review.",
    "query": "query BatchSubmission($id: ID!, $version: Int!) {\n  changeBatch(id: $id) {\n    id\n    submittedVersion\n    submission(version: $version)\n  }\n}",
    "hash": "4a22de2d716c115093de2551dd33f0996624e59041b393cfce26304e5b17e5ec",
    "variables": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "GraphQL ID!"
        },
        "version": {
          "type": "integer",
          "description": "GraphQL Int!"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "mcp": {
      "description": "Read the original proposals, author and time of one submitted batch version."
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "changeBatch": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "submittedVersion": {
              "type": "integer"
            },
            "submission": {
              "description": "JSON",
              "nullable": true
            }
          },
          "nullable": true
        }
      }
    }
  },
