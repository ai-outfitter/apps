---
import { readVisualEvidence } from "../../../server/visual-evidence";
import { planningContext } from "../../../server/context";
import { appHref } from "../../../app-href";
import Layout from "../../../components/PlanningLayout.astro";
import Button from "@ai-outfitter/ui/astro/Button.astro";
import EvidenceViewer from "../../../components/EvidenceViewer";
import { projectEvidenceViews } from "../../../server/project-releases";
import ReleaseContent from "../../../components/ReleaseContent";
import { requestIdentity, requestPageURL } from "@ai-outfitter/app-sdk/server";
import { workflowHost } from "@ai-outfitter/app-sdk/workflow-host";
import { demoProjectReleases, readProjectReleases, type ProjectReleaseReview } from "../../../server/project-releases";
import { wikiPageHref } from "../../../server/wiki-links";
const projectId = Astro.params.id ?? "";
const demo = import.meta.env.OUTFITTER_APP_MODE === "demo";
let model: ProjectReleaseReview | undefined;
let error = "";
let pending: Awaited<ReturnType<typeof readVisualEvidence>> | undefined;
const pendingBatch = Astro.url.searchParams.get("batch");
try {
  if (!demo && pendingBatch) pending = await readVisualEvidence(planningContext(Astro.request,Astro.locals),{projectId,bundleId:Astro.url.searchParams.get("bundle"),batchId:pendingBatch});
  else if (demo) model = demoProjectReleases(projectId);
  else { const identity = requestIdentity(Astro.request); model = await readProjectReleases(workflowHost<"interactive">(Astro.locals), identity.installationId, projectId); }
} catch (failure) {
  if (failure instanceof Response && [401, 403].includes(failure.status)) throw failure;
  Astro.response.status = failure instanceof Response && [404, 409, 413].includes(failure.status) ? failure.status : 503;
  error = Astro.response.status === 404 ? "Project not found." : "Evidence is unavailable. Check the project's Wiki links and retry.";
}
const documents = model?.documents ?? [];
const bundleId = Astro.url.searchParams.get("bundle");
const document = bundleId ? documents.find(node => node.id === bundleId) : documents[0];
if (!pending && !error && bundleId && !document) { Astro.response.status = 404; error = "This record is not linked to the selected project."; }
const source = document && model?.wiki ? wikiPageHref(model.wiki, requestPageURL(Astro.request), `documents/${document.id}`) : "";
const legacy = model?.project.legacy ?? "";
let views: ReturnType<typeof projectEvidenceViews> = [];
try { if (model) views = projectEvidenceViews(model); } catch (failure) { error = (failure as Error).message; }
const selected = pending && "bundle" in pending ? pending.bundle : views.find(view => view.id === document?.id);
const focus = {kind: "planning-project", id: projectId, label: model?.project.title ?? "Project", revision: model?.project.revision};
---
<Layout title="Evidence" description={model?.project.title ?? "Review this project's supporting evidence."} wiki={model?.wiki ?? null} {focus}>
  <div slot="intro-actions"><Button href={appHref(Astro.url.pathname, `/projects/${projectId}`)} variant="secondary">← Back to project</Button></div>
  {demo && <p class="planning-notice">Read-only demo · These evidence records are synthetic.</p>}
  {error ? <p role="alert">{error}</p> : <>
    {documents.length > 1 && <nav class="planning-toolbar planning-release-records" aria-label="Evidence records">
      {documents.map(node => <Button href={`?bundle=${node.id}`} variant="secondary" aria-current={document?.id === node.id ? "page" : undefined}>{node.title}</Button>)}
    </nav>}
    {pending && <p role="status" class="planning-notice">Pending graph review · This capture has not been applied to the product revision.</p>}
    {selected && <EvidenceViewer bundle={selected} comparisons={views} projectRevision={pending && "projectRevision" in pending ? pending.projectRevision : model?.project.revision} evidenceHref={appHref(Astro.url.pathname, `/projects/${projectId}/evidence`)} client:load />}
    <details class="planning-release-reader"><summary>Source records and JSON</summary>
      {document ? <><p>Record revision {document.revision}{source && <> · <a href={source}>Wiki source</a></>}</p>
        {selected?.legacy ? <ReleaseContent content={document.body} /> : <pre>{JSON.stringify(JSON.parse(document.body), null, 2)}</pre>}
        <a download={`evidence-${document.id}.${selected?.legacy ? "md" : "json"}`} href={`data:${selected?.legacy ? "text/plain" : "application/json"};charset=utf-8,${encodeURIComponent(document.body)}`}>Download source</a>
      </> : pending && selected ? <pre>{JSON.stringify(selected, null, 2)}</pre> : legacy ? <ReleaseContent content={legacy} /> : <p>No evidence documents are linked to this project yet.</p>}
    </details>
    {!selected && <p>No visual evidence captured. A manifest link alone is not a captured walkthrough.</p>}
  </>}
</Layout>
