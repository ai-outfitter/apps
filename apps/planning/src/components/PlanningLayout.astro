---
// The demo build resolves this to the shared scripted sidebar (astro.config.mjs).
import AppAgentSidebar from "@ai-outfitter/ui/react/AppAgentSidebar";
import AppLayout from "@ai-outfitter/ui/astro/ManagedAppLayout.astro";
import { appHref } from "../app-href";
import "../planning.css";
import { requestPageURL } from "@ai-outfitter/app-sdk/server";
import { requestUiPreferences } from "@ai-outfitter/app-sdk/ui-preferences";
import type { WikiContext } from "../scripts/wiki-context";
import { wikiPageHref } from "../server/wiki-links";
import { intakeFocus } from "../agent-focus";

interface Props {
  title: string;
  description: string;
  wiki?: WikiContext | null;
}
const { title, description, wiki } = Astro.props;
const demo = import.meta.env.OUTFITTER_APP_MODE === "demo";
const path = Astro.url.pathname;
const section = (route: string) => path === route || path.startsWith(`${route}/`);
// Relative links, so a personal /apps/<slug>/ install keeps them inside the app.
const link = (label: string, route: string, active = section(route)) => ({ label, href: appHref(path, route), active });
const sidebarLinks = [
  link("Intake", "/intake"),
  link("Product", "/", path === "/"),
  link("Operations", "/operations"),
  link("Projects", "/projects"),
  link("Products", "/products"),
  link("Opportunities", "/opportunities"),
  link("Use cases", "/use-cases"),
  link("Customer segments", "/customer-segments"),
  ...(wiki === null ? [] : [{ label: "Wiki ↗", href: wiki ? wikiPageHref(wiki, requestPageURL(Astro.request)) : "#", id: wiki === undefined ? "planning-wiki-link" : "planning-wiki-link-resolved", active: false }]),
];
const intake = Astro.url.pathname.startsWith("/intake");
const products = Astro.url.pathname === "/products" || Astro.url.pathname.startsWith("/products/");
// The sidebar arrives open when the member left it open (the outfitter-ui cookie).
const agentOpen = requestUiPreferences(Astro.request).agent === "planning-agent";
const limits = demo
  ? "Scripted, read-only demo. No inference or writes."
  : products ? "Uses this organization’s saved products and weekly roadmap. Confirm changes before they are submitted." : intake ? "Uses saved intake, active controls and reviewed work packages. Writes require explicit review and current authority." : "Uses saved Planning records and pasted notes. Proposed changes stay private until you approve them.";
---

<AppLayout
  name="Planning"
  {title}
  {description}
  active={path === "/settings" ? "settings" : "home"}
  settingsHref={appHref(path, "/settings")}
  {sidebarLinks}
>
  <slot name="intro-actions" slot="intro-actions" />
  <button slot="header-actions" data-astro-transition-persist="planning-agent:toggle" class="ui-button ui-button--secondary" type="button" data-agent-sidebar-toggle aria-controls="planning-agent" aria-expanded={agentOpen ? "true" : "false"} disabled>Ask Outfitter</button>
  <div class="planning-content"><slot /></div>
  <AppAgentSidebar
    slot="overlays"
    client:idle
    transition:persist
    id="planning-agent"
    initialOpen={agentOpen}
    pageId="planning"
    endpoint="/api/apps/planning/agent"
    {demo}
    intro={products ? "Ask about this organization’s products and weekly roadmap." : intake ? "Describe a customer need or competitor. Inspect routes and evidence, then review proposed work." : "Discuss products, projects or the next piece of work. Review proposed changes before saving."}
    emptyIntro={products ? "Loading product context…" : "Ask about customer and competitive intake."}
    defaultFocus={intakeFocus}
    {limits}
    demoReply="This is a scripted, read-only example. In operational Planning, Outfitter can discuss meeting notes and saved project documents, then prepare projects or issues for your review. No inference ran and no records changed."
  />
</AppLayout>
<script>
  import "../scripts/wiki-context";
  import { setOrganizationLink } from "../../navigation.js";
  setOrganizationLink("planning");
</script>
