{
  "$id": "https://outfitter.ai/schemas/workshop-box/design-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "designed",
        "failed"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 4000
    },
    "path": {
      "type": "string",
      "pattern": "^designs\\/[a-z0-9][a-z0-9-]{0,63}$"
    },
    "via": {
      "type": "string",
      "enum": [
        "agent",
        "graphql"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision",
        "name"
      ],
      "additionalProperties": false
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "width",
              "depth",
              "height"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "message",
          "rationale",
          "dimensions",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "geometry": {
      "type": "object",
      "properties": {
        "bounds": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "width",
            "depth",
            "height"
          ],
          "additionalProperties": false
        },
        "volumeMm3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "features": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "bounds",
        "volumeMm3",
        "features"
      ],
      "additionalProperties": false
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "fabricated",
              "purchased"
            ]
          },
          "volumeMm3": {
            "type": "number",
            "minimum": 0
          },
          "bounds": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "width",
              "depth",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "part",
          "quantity",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "uri": {
            "type": "string",
            "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "uri"
        ],
        "additionalProperties": false
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string",
            "pattern": "^screenshots\\/[^/]+\\/[a-z0-9-]+\\.png$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "uri": {
            "type": "string",
            "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
          },
          "ready": {
            "type": "boolean"
          }
        },
        "required": [
          "step",
          "revision",
          "path",
          "sha256",
          "bytes",
          "uri",
          "ready"
        ],
        "additionalProperties": false
      }
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "uri",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "evidenceBundle": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "uri",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tag",
        "url",
        "artifacts",
        "evidenceBundle"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "modelSeconds": {
          "type": "number",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokensPerSecond": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "modelCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "inputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "status",
              "seconds",
              "modelCalls",
              "inputTokens",
              "outputTokens"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "wallSeconds",
        "modelSeconds",
        "modelCalls",
        "inputTokens",
        "outputTokens",
        "outputTokensPerSecond",
        "steps"
      ],
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "agent",
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "path",
    "iterations",
    "bom",
    "files",
    "model",
    "startedAt",
    "finishedAt"
  ],
  "additionalProperties": false
}
