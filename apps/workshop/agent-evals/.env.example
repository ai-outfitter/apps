# Copy to .env.<experiment> (.env.luna, .env.spark). The box's gateway is the only
# process that receives these (box/README.md, "Models"). AI_MODEL must match the
# experiment's `model`.

# Luna (.env.luna)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna

# DGX Spark on the LAN (.env.spark). Behind Cloudflare Access, also set
# SPARK_ACCESS_CLIENT_ID and SPARK_ACCESS_CLIENT_SECRET.
# SPARK_BASE_URL=http://192.168.1.176:8888/v1
# SPARK_AUTHORIZATION=Bearer lan
# AI_MODEL=GLM-5.3-Flash-EXL3
