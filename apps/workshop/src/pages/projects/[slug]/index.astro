---
import WorkshopPage from "../../../components/WorkshopPage.astro";
import { slugId } from "../../../lib/sections";
import { installationDatabase } from "@ai-outfitter/app-sdk/cloudflare/database";
import { listWorkshopProjects, getWorkshopProject } from "../../../server/projects";
import { hasPcbReview } from "../../../lib/pcb-review";

let projectName: string | undefined;
const slug = Astro.params.slug ?? "";
if (!slugId(slug)) return new Response("Not found", { status: 404 });
let section: "models" | "pcb" = "models";
if (import.meta.env.OUTFITTER_APP_MODE !== "demo") {
  try {
  const db = installationDatabase();
  const summary = (await listWorkshopProjects(db)).find(p => p.id.endsWith(slugId(slug)!));
  if (summary) { projectName = summary.name; const project=await getWorkshopProject(db,summary.id); if(project.pcbSnapshots?.length || hasPcbReview(project.workspace)) section="pcb"; }
  } catch { /* The normal project view reports record-loading failures. */ }
}
---
<WorkshopPage section={section} slug={slug} {projectName} hasPcb={section === "pcb"} />
