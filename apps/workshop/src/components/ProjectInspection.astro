---
import BillOfMaterials from "./BillOfMaterials.astro";
import SelectedComponent from "./SelectedComponent.astro";
const tabs = [
  ["description", "Description"], ["components", "Components"], ["bom", "BOM"],
  ["power", "Power"], ["selected", "Selected"],
];
const initialTab = tabs[0][0];
---
<aside id="project-inspection" aria-label="Project inspection" inert>
  <div role="tablist" aria-label="Project information">
    {tabs.map(([id, label]) => <button type="button" role="tab" id={`tab-${id}`} aria-controls={`pane-${id}`}
      aria-selected={id === initialTab ? "true" : "false"} tabindex={id === initialTab ? 0 : -1}
      hidden={["bom","power","selected"].includes(id)}>{label}</button>)}
  </div>
  {tabs.map(([id]) => <section role="tabpanel" id={`pane-${id}`} aria-labelledby={`tab-${id}`}
    hidden={id !== initialTab} tabindex="0">
    {id === "description" && <><p id="project-brief"></p><span id="revision-label"></span></>}
    {id === "bom" && <BillOfMaterials />}
    {id === "power" && <section id="power-panel" aria-label="Assembly power budget"></section>}
    {id === "components" && <div id="inspection-tree"></div>}
    {id === "selected" && <><button id="back-components" type="button">Back to components</button><SelectedComponent /></>}
  </section>)}
</aside>
