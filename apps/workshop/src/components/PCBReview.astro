---
const {slug}=Astro.props;
---
<div id="pcb-review" data-slug={slug}>
 <header class="pcb-heading"><div><p class="pcb-eyebrow">WORKSHOP / ELECTRONICS</p><h1 id="pcb-title">PCB review</h1><p id="pcb-subtitle">Loading the saved board revision…</p></div><a id="pcb-bundle" hidden>Download engineering package ↗</a></header>
 <p id="pcb-notice" role="status"></p>
 <div class="pcb-grid"><section class="pcb-stage"><div id="pcb-canvas" aria-label="Interactive 3D PCB"></div><p id="pcb-model-status" role="status"></p><div class="pcb-controls" id="pcb-controls"><button type="button" data-camera="perspective" disabled>Perspective</button><button type="button" data-camera="top" disabled>Top</button><button type="button" data-camera="bottom" disabled>Bottom</button><button type="button" id="pcb-spin" aria-pressed="false" disabled>Rotate</button></div><p id="pcb-model-note"></p></section>
 <aside><h2>Board revision</h2><dl id="pcb-facts"></dl><h3>Source record</h3><dl id="pcb-provenance"></dl><p id="pcb-provenance-note" class="pcb-small"></p><h3>Validation</h3><div id="pcb-checks"></div><h3>Selected component</h3><p id="pcb-selection">Select a BOM row to inspect its part number and footprint.</p></aside></div>
 <nav class="pcb-tabs" aria-label="Board information"><a href="#pcb-bom">Bill of materials</a><a href="#pcb-power">Power</a><a href="#pcb-manufacturing">Manufacturing</a></nav>
 <section id="pcb-bom"><div class="pcb-section-title"><h2>Bill of materials</h2><label>Find a component <input id="pcb-search" type="search" placeholder="Reference, part number, function" /></label></div><p id="pcb-bom-count"></p><div class="pcb-table-scroll"><table><thead><tr><th>Reference</th><th>Qty</th><th>Manufacturer part number</th><th>Value / function</th></tr></thead><tbody id="pcb-rows"></tbody></table></div></section>
 <section id="pcb-power"><h2>Power budget</h2><p id="pcb-power-basis"></p><div id="pcb-power-cards"></div><p id="pcb-power-notes"></p></section>
 <section id="pcb-manufacturing"><h2>Manufacturing & downloads</h2><p id="pcb-manufacturing-note"></p><div id="pcb-downloads"></div><h3 id="pcb-quotes-heading">Supplier assembly quotes</h3><div id="pcb-quotes"></div><p>A price requires a quote record with a supplier reference, date, assembly scope and evidence file. Check the attached evidence; Workshop does not authenticate supplier quotes. Shipping and tax depend on the delivery destination.</p></section>
</div>
<script>import "../client/pcb-review";</script>
<style is:global>
#pcb-review{max-width:1500px;margin:auto;padding:24px;color:var(--text,#d9e1e7)}.pcb-heading{display:flex;justify-content:space-between;gap:24px;align-items:center}.pcb-heading h1{font-size:34px;margin:4px 0}.pcb-eyebrow{font-size:11px;letter-spacing:.18em;color:#78b3a0}.pcb-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:24px;margin:22px 0}.pcb-stage{background:#111d26;border:1px solid #344650;border-radius:18px;overflow:hidden}#pcb-canvas{height:500px;width:100%;touch-action:none}.pcb-controls{display:flex;gap:8px;justify-content:center;padding:12px}.pcb-controls button{border:1px solid #506571;background:#1b303a;color:#eef4f6;padding:7px 14px;border-radius:7px}.pcb-controls button:disabled{opacity:.5}.pcb-stage p{padding:0 20px 10px;font-size:12px;color:#aebfc8}#pcb-review aside{padding:20px;border:1px solid #71838a55;border-radius:16px}#pcb-review aside h2{margin-top:0}#pcb-facts{display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:14px}#pcb-facts dd{margin:0;text-align:right}#pcb-provenance{display:grid;grid-template-columns:auto 1fr;gap:8px 12px;font-size:12px}#pcb-provenance dd{margin:0;text-align:right;overflow-wrap:anywhere}#pcb-model-status:empty,#pcb-provenance-note:empty{display:none}.pcb-small{font-size:12px;color:var(--muted,#65737b)}.pcb-check small{display:block;font-size:12px;color:var(--muted,#65737b)}.pcb-check-fail strong{color:#d46a5f}.pcb-check-pass strong{color:#78b3a0}.pcb-tabs{display:flex;gap:24px;border-bottom:1px solid #71838a55;padding:14px 0;margin-bottom:24px}.pcb-section-title{display:flex;justify-content:space-between;align-items:center;gap:15px}#pcb-search{margin-left:8px;padding:8px;border:1px solid #71838a88;border-radius:6px}.pcb-table-scroll{max-height:430px;overflow:auto}#pcb-review table{width:100%;border-collapse:collapse;font-size:14px}#pcb-review th,#pcb-review td{text-align:left;padding:10px 12px;border-bottom:1px solid #71838a33}#pcb-review th{position:sticky;top:0;background:var(--surface,#1b2931)}#pcb-review tbody tr:hover{background:#599d8622}#pcb-review td button{background:none;border:0;color:#599d86;font:inherit;cursor:pointer}#pcb-review section[id]{scroll-margin-top:70px;margin-bottom:32px}#pcb-power-cards,#pcb-quotes{display:flex;gap:16px;flex-wrap:wrap}#pcb-power-cards article,#pcb-quotes article{padding:20px;border:1px solid #71838a55;border-radius:12px;min-width:180px}#pcb-power-cards strong{font-size:28px;display:block}#pcb-quotes strong{font-size:22px;display:block}#pcb-quotes .pcb-quote-open strong{color:var(--muted,#65737b)}#pcb-downloads{display:flex;flex-wrap:wrap;gap:12px}#pcb-downloads a{padding:10px 15px;border:1px solid #71838a55;border-radius:8px}#pcb-notice{color:#c18432}#pcb-selection{overflow-wrap:anywhere;font-size:13px}#pcb-review a{color:#599d86}@media(max-width:850px){.pcb-grid{grid-template-columns:1fr}#pcb-canvas{height:360px}.pcb-heading,.pcb-section-title{align-items:flex-start;flex-direction:column}#pcb-review{padding:12px}}
</style>
