---
import "../styles/workshop.css";
import { PHASES } from "../lib/project";
import type { SectionId } from "../lib/sections";

interface Props { section: SectionId; slug: string }
const { section, slug } = Astro.props;
---
<div class="workshop" data-section={section} data-slug={slug}>
    <div class="shell">
      <div class="workbench">
        <header class="topbar">
          <nav class="crumbs" aria-label="Project">
            <a id="projects-link" href="/">Projects</a>
            <span aria-hidden="true">/</span>
            <strong id="project-title">Loading project…</strong>
            <span id="project-phase" class="phase-label"></span>
            <span id="revision-ref" class="revision-ref" hidden>
              builds <a id="revision-link" target="_blank" rel="noopener noreferrer"></a>
            </span>
          </nav>
          <div class="save-group">
            <span id="save-state" role="status">
              Organization projects
            </span>
            <button id="delete-project" class="secondary">Delete project</button>
            <button id="save" class="primary" disabled>
              Save project
            </button>
          </div>
        </header>

        <form id="agent-form" class="card form-card agent-card">
          <div class="eyebrow">DESIGN WITH SPARK</div>
          <h2 id="agent-title">Change this model</h2>
          <label for="agent-message">What should we make or change?</label>
          <textarea
            id="agent-message"
            name="message"
            rows="2"
            maxlength="500"
            required
            placeholder="Make a solid cube 40 mm on each side"
          ></textarea>
          <div class="actions">
            <button id="agent-submit" type="submit" class="primary">Update model</button>
          </div>
          <p id="agent-status" class="muted" role="status" aria-live="polite">
            Spark makes a design study. Check dimensions and physical fit before fabrication.
          </p>
          <ol id="agent-history" class="agent-history" hidden></ol>
        </form>

        <p id="project-missing" class="muted" hidden>This project doesn't exist or was deleted. <a href="/">See all projects</a>.</p>
        <div id="workspace" hidden>
          <section data-panel="overview" hidden={section !== "overview"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">01 / DEFINE THE JOB</div>
                <h2>What are we making?</h2>
                <p>
                  Give the project a purpose and a few things it must get right.
                </p>
              </div>
              <span class="badge">Draft project</span>
            </div>
            <div class="overview-grid">
              <form id="brief-form" class="card form-card">
                <label>
                  Project name
                  <input name="name" required maxlength="100" />
                </label>
                <label>
                  Who is building it?
                  <input
                    name="owner"
                    maxlength="100"
                    placeholder="A person or team"
                  />
                </label>
                <label>
                  The need
                  <textarea
                    maxlength="5000"
                    name="brief"
                    rows="3"
                    placeholder="Describe the problem this should solve"
                  ></textarea>
                </label>
                <label>
                  Manufacturing stage
                  <select name="phase" id="phase-select">
                    {PHASES.map((p) => <option value={p.id}>{p.label}</option>)}
                  </select>
                </label>
                <label>
                  Requirements & acceptance
                  <textarea
                    maxlength="5000"
                    name="requirements"
                    rows="5"
                    placeholder="Dimensions, environment, budget, and how you will know it works"
                  ></textarea>
                </label>
                <details class="revision-picker">
                  <summary>Product revision</summary>
                  <label>
                    Wiki link
                    <input
                      name="revisionLink"
                      maxlength="2000"
                      placeholder="Paste the revision's Wiki link or ID"
                    />
                  </label>
                  <label>
                    Title
                    <input name="revisionTitle" maxlength="200" />
                  </label>
                  <label>
                    Wiki installation ID
                    <input name="revisionWiki" maxlength="100" placeholder="Optional" />
                  </label>
                </details>
              </form>
              <div>
                <article class="card next-card">
                  <span class="eyebrow">A USEFUL NEXT STEP</span>
                  <h2 id="next-title"></h2>
                  <p id="next-body"></p>
                  <button id="next-action" class="text-button">
                    Open research →
                  </button>
                </article>
                <article class="card">
                  <h3>What we know</h3>
                  <div id="summary"></div>
                  <p class="muted">
                    Digital checks and physical observations each have their own
                    evidence.
                  </p>
                </article>
              </div>
            </div>
          </section>
          <section data-panel="research" hidden={section !== "research"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">02 / INVESTIGATE FIRST</div>
                <h2>Build, buy, or adapt?</h2>
                <p>
                  Keep the useful finds and the reasons behind your choices.
                </p>
              </div>
            </div>
            <div class="search-card card">
              <form id="search-form">
                <label>
                  Look for an existing solution
                  <input
                    id="research-query"
                    placeholder="e.g. adjustable desk cable holder"
                    required
                  />
                </label>
                <div class="actions">
                  <button type="submit">Search the web ↗</button>
                  <button type="button" id="search-repos">
                    Open-source repos ↗
                  </button>
                  <button type="button" id="search-models">
                    Printable designs ↗
                  </button>
                </div>
              </form>
              <p class="muted">
                Search opens in a new tab. Add exact product pages, drawings,
                licenses, or repository revisions below.
              </p>
            </div>
            <div class="split">
              <form id="research-form" class="card form-card">
                <h2>Add a candidate</h2>
                <label>
                  Name
                  <input name="name" required maxlength="150" />
                </label>
                <div class="two-cols">
                  <label>
                    Type
                    <select name="kind">
                      <option>COTS</option>
                      <option>Open design</option>
                      <option>Prior art</option>
                    </select>
                  </label>
                  <label>
                    Decision
                    <select name="decision">
                      <option>Investigate</option>
                      <option>Use</option>
                      <option>Adapt</option>
                      <option>Reject</option>
                    </select>
                  </label>
                </div>
                <label>
                  Source URL
                  <input
                    name="url"
                    type="url"
                    maxlength="2000"
                    placeholder="https://"
                  />
                </label>
                <label>
                  What did you learn?
                  <textarea
                    maxlength="5000"
                    name="notes"
                    rows="4"
                    placeholder="Fit, availability date, exact revision, license, and tradeoffs"
                  ></textarea>
                </label>
                <button class="primary">Add candidate</button>
              </form>
              <div id="research-list" class="stack"></div>
            </div>
          </section>
          <section data-panel="design" hidden={section !== "design"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">03 / MAKE IT FIT</div>
                <h2>Design workbench</h2>
                <p>Inspect a parametric solid. Change generated designs with a follow-up request.</p>
              </div>
              <span class="badge">Millimeters</span>
            </div>
            <div class="design-grid">
              <div class="viewer-card">
                <canvas
                  id="viewer"
                  aria-label="Interactive 3D preview of the prototype"
                ></canvas>
                <div class="viewer-top">
                  <span>PROTOTYPE · PARAMETRIC STUDY</span>
                  <button id="reset-view">Reset view</button>
                </div>
                <div class="viewer-bottom">
                  <span>Drag to orbit · scroll to zoom</span>
                  <span id="geometry-status" role="status">
                    Loading geometry…
                  </span>
                </div>
              </div>
              <div class="card form-card">
                <h2 id="dimensions-title">Dimensions</h2>
                <p id="dimensions-help" class="muted"></p>
                <form id="dimensions" class="form-card">
                  <label>
                    Width <span>mm</span>
                    <input
                      name="width"
                      type="number"
                      min="25"
                      max="200"
                      step="0.1"
                      required
                    />
                  </label>
                  <label>
                    Depth <span>mm</span>
                    <input
                      name="depth"
                      type="number"
                      min="20"
                      max="160"
                      step="0.1"
                      required
                    />
                  </label>
                  <label>
                    Height <span>mm</span>
                    <input
                      name="height"
                      type="number"
                      min="8"
                      max="80"
                      step="0.1"
                      required
                    />
                  </label>
                  <label id="wall-label">
                    Wall <span>mm</span>
                    <input
                      name="wall"
                      type="number"
                      min="1.2"
                      max="6"
                      step="0.1"
                      required
                    />
                  </label>
                </form>
                <div id="geometry-checks" class="checks"></div>
                <div class="actions">
                  <button id="step" disabled>
                    ↓ STEP
                  </button>
                  <button id="stl" disabled>
                    ↓ STL
                  </button>
                </div>
              </div>
            </div>
            <div class="card measurement-card">
              <label>
                Measurement sources & assumptions
                <textarea
                  maxlength="5000"
                  id="measurement-notes"
                  rows="2"
                  placeholder="Record what you measured, the units and method, and what is still an assumption."
                ></textarea>
              </label>
              <p class="muted">
                These prototype studies use scaled, unverified feature dimensions.
                  Measure the actual components and test fit before making parts.
                </p>
            </div>
          </section>
          <section data-panel="parts" hidden={section !== "parts"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">04 / KNOW WHAT GOES IN</div>
                <h2>Parts & cost</h2>
                <p>
                  Use exact part identities and dated prices as the design takes
                  shape.
                </p>
              </div>
              <div class="cost-total">
                <small>PARTS SUBTOTAL</small>
                <strong id="parts-total">$0.00</strong>
              </div>
            </div>
            <div class="card table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Part</th>
                    <th>Qty</th>
                    <th>Unit · USD</th>
                    <th>Total</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="parts-list"></tbody>
              </table>
              <p class="muted">
                Parts subtotal excludes shipping, tax, fabrication, assembly
                labor, and returns. A zero is an entered estimate, not a
                supplier quote.
              </p>
            </div>
            <form id="part-form" class="card form-card">
              <h2>Add a part or material</h2>
              <div class="three-cols">
                <label>
                  Part / exact revision
                  <input name="name" required maxlength="150" />
                </label>
                <label>
                  Quantity
                  <input
                    name="quantity"
                    type="number"
                    min="1"
                    max="10000"
                    step="1"
                    value="1"
                    required
                  />
                </label>
                <label>
                  Unit cost · USD
                  <input
                    name="unitCost"
                    type="number"
                    min="0"
                    max="100000"
                    step="0.01"
                    value="0"
                    required
                  />
                </label>
              </div>
              <label>
                Source URL
                <input
                  name="source"
                  type="url"
                  maxlength="2000"
                  placeholder="https://"
                />
              </label>
              <label>
                Notes
                <input
                  name="notes"
                  maxlength="5000"
                  placeholder="Dimensions, quote date, availability, or alternatives"
                />
              </label>
              <button class="primary fit-button">Add part</button>
            </form>
          </section>
          <section data-panel="bench" hidden={section !== "bench"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">05 / BUILD, OBSERVE, REPEAT</div>
                <h2>Bench & evidence</h2>
                <p>
                  A clear observation is more useful than a confident
                  assumption.
                </p>
              </div>
            </div>
            <article id="circuit-card" class="card">
              <label>
                Hardware & firmware baseline
                <textarea
                  maxlength="5000"
                  id="circuit-notes"
                  rows="3"
                  placeholder="Exact board revision, pin map, supply, firmware commit, and wiring reference"
                ></textarea>
              </label>
              <p class="muted">
                Changes to this baseline or the recorded parts require a new
                breadboard acceptance test.
              </p>
            </article>
            <div class="split">
              <form id="evidence-form" class="card form-card">
                <h2>Record an observation</h2>
                <div class="two-cols">
                  <label>
                    Stage
                    <select name="stage">
                      <option>Measurement</option>
                      <option>Fit test</option>
                      <option>Breadboard</option>
                      <option>PCB bring-up</option>
                    </select>
                  </label>
                  <label>
                    Result
                    <select name="outcome">
                      <option>Observation</option>
                      <option>Pass</option>
                      <option>Fail</option>
                    </select>
                  </label>
                </div>
                <label>
                  Observed by
                  <input
                    name="operator"
                    required
                    maxlength="100"
                    placeholder="Your name"
                  />
                </label>
                <label>
                  Procedure and result
                  <textarea
                    maxlength="2000"
                    name="note"
                    required
                    rows="5"
                    placeholder="What you tested, exact parts or firmware, what happened, and what remains unknown."
                  ></textarea>
                </label>
                <label class="checkbox">
                  <input name="includeSerial" type="checkbox" /> Attach current
                  serial log
                </label>
                <p class="muted">
                  Review logs for passwords or tokens before attaching. Exports
                  include the last 4,000 characters.
                </p>
                <button class="primary">Save observation</button>
                <p class="muted">
                  Recorded against the current dimensions. A later dimension
                  change needs a new fit test.
                </p>
              </form>
              <div id="evidence-list" class="stack"></div>
            </div>
            <article class="card serial-card">
              <div class="serial-heading">
                <div>
                  <h2>Device console</h2>
                  <p id="serial-status">
                    Connect a board over USB to read its serial output.
                  </p>
                </div>
                <div class="actions">
                  <label class="visually-hidden" for="baud">
                    Baud rate
                  </label>
                  <select id="baud">
                    <option>115200</option>
                    <option>9600</option>
                  </select>
                  <button id="serial-connect">Connect USB device</button>
                  <button id="serial-disconnect" disabled>
                    Disconnect
                  </button>
                  <button id="serial-clear">Clear</button>
                </div>
              </div>
              <pre
                id="serial-output"
                aria-label="Serial output"
              >No device connected.</pre>
              <p class="muted">
                Requires a browser with Web Serial and your explicit device
                selection. This draft reads logs; firmware flashing and a
                server-side device bridge are future adapters.
              </p>
            </article>
          </section>
          <section data-panel="release" hidden={section !== "release"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">06 / MAKE IT REPRODUCIBLE</div>
                <h2>Package & handoff</h2>
                <p>
                  Take the project files with you, including the things still to
                  test.
                </p>
              </div>
            </div>
            <div class="overview-grid">
              <article class="card">
                <span class="eyebrow">PORTABLE PROJECT</span>
                <h2>A record of this iteration</h2>
                <p>
                  The ZIP includes your brief, dimensions, parts, research,
                  observations, and a checksum manifest.
                </p>
                <ul class="package-list">
                  <li>Editable project JSON</li>
                  <li>Requirements & measurement provenance</li>
                  <li>BOM with sources and entered costs</li>
                  <li>Research decisions & test observations</li>
                  <li>SHA-256 artifact manifest</li>
                </ul>
                <button id="package" class="primary">
                  ↓ Download draft package
                </button>
                <p class="muted">
                  Export STEP/STL separately from the Design workbench. A draft
                  package is not manufacturing approval.
                </p>
              </article>
              <article class="card">
                <span class="eyebrow">OPTIONAL NEXT STEP</span>
                <h2>From breadboard to PCB</h2>
                <div id="pcb-state"></div>
                <p>
                  When a custom board is justified, freeze the verified parts
                  and pin map. The handoff includes the KiCad review sequence;
                  the Workshop source directory contains an optional MCP configuration
                  and CLI checks.
                </p>
                <ol class="workflow-list">
                  <li>Record breadboard acceptance</li>
                  <li>Compare carrier, perfboard, and custom board</li>
                  <li>Review schematic and run ERC</li>
                  <li>Review layout and run DRC</li>
                  <li>Check enclosure fit and physical bring-up</li>
                </ol>
              </article>
            </div>
          </section>
          <section data-panel="assembly" hidden={section !== "assembly"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">08 / WHAT WE BUILD AND WHAT WE HAVE</div>
                <h2>Assembly & inventory</h2>
                <p>The product structure with its sub-assemblies, firmware and COTS parts, and the units in stock.</p>
              </div>
              <div class="cost-total">
                <small>COST PER ASSEMBLY</small>
                <strong id="assembly-total">$0.00</strong>
              </div>
            </div>
            <div class="viewer-card assembly-viewer">
              <canvas id="assembly-viewer" aria-label="Interactive 3D view of the whole assembly"></canvas>
              <div class="viewer-top">
                <span id="assembly-title">ASSEMBLY</span>
                <button id="assembly-reset">Reset view</button>
              </div>
              <div class="viewer-bottom">
                <span>Select a BOM line to isolate it</span>
                <span id="assembly-status" role="status">Loading assembly…</span>
              </div>
            </div>
            <p id="assembly-empty" class="muted" hidden>
              This project has no assembly yet. Start the SNY-1 soil sensor node example to see one.
            </p>
            <div class="card table-wrap">
              <table class="bom">
                <thead>
                  <tr>
                    <th>Part number</th>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Qty</th>
                    <th>Ref</th>
                    <th>Manufacturer · MPN</th>
                    <th>In stock</th>
                  </tr>
                </thead>
                <tbody id="bom-list"></tbody>
              </table>
            </div>
            <h2 class="subheading">Inventory</h2>
            <p class="muted">Units are tracked by MAC address when the part has a radio, otherwise by serial. Firmware is the ref last flashed.</p>
            <div class="card table-wrap">
              <table class="units">
                <thead>
                  <tr>
                    <th>Part number</th>
                    <th>MAC · serial</th>
                    <th>Status</th>
                    <th>Location</th>
                    <th>Firmware</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="unit-list"></tbody>
              </table>
            </div>
            <form id="unit-form" class="card form-card">
              <h2>Add a unit</h2>
              <div class="three-cols">
                <label>
                  Part
                  <select name="partNumber" id="unit-part" required></select>
                </label>
                <label>
                  MAC address
                  <input name="mac" maxlength="17" placeholder="34:85:18:AA:BB:CC" autocomplete="off" />
                </label>
                <label>
                  Serial
                  <input name="serial" maxlength="100" />
                </label>
              </div>
              <div class="three-cols">
                <label>
                  Status
                  <select name="status">
                    <option value="in-stock">In stock</option>
                    <option value="allocated">Allocated to this project</option>
                    <option value="installed">Installed in a build</option>
                    <option value="retired">Retired</option>
                  </select>
                </label>
                <label>
                  Location
                  <input name="location" maxlength="100" placeholder="Bin A3" />
                </label>
                <label>
                  Firmware flashed
                  <input name="firmware" maxlength="100" placeholder="v0.1.0" />
                </label>
              </div>
              <span id="unit-status" class="muted" role="status" aria-live="polite"></span>
              <button class="primary fit-button">Add unit</button>
            </form>
          </section>
          <section data-panel="concepts" hidden={section !== "concepts"}>
            <div class="section-heading">
              <div>
                <div class="eyebrow">07 / WHAT IT COULD LOOK LIKE</div>
                <h2>Design concepts</h2>
                <p>
                  Mockups of the product as we imagine it. Design intent, not
                  a photograph or a measurement.
                </p>
              </div>
            </div>
            <form id="concept-form" class="concept-form">
              <label>
                Prompt
                <textarea
                  id="concept-prompt"
                  name="prompt"
                  rows="4"
                  maxlength="4000"
                  required
                  placeholder="What the product looks like, where it sits, its materials and finish"
                ></textarea>
              </label>
              <label>
                Caption
                <input name="caption" maxlength="300" placeholder="Optional" />
              </label>
              <p class="concept-actions">
                <button type="submit" class="link">Generate image</button>
                <label class="link">
                  Upload an image
                  <input
                    id="concept-upload"
                    type="file"
                    accept="image/png,image/jpeg,image/webp"
                    class="visually-hidden"
                  />
                </label>
                <span id="concept-status" class="muted" role="status" aria-live="polite"></span>
              </p>
            </form>
            <div id="concept-gallery" class="concept-gallery"></div>
            <form id="concept-publish" class="concept-publish">
              <label>
                Product revision
                <input
                  name="productRevision"
                  maxlength="2000"
                  required
                  placeholder="Wiki revision link or ID"
                />
              </label>
              <p class="concept-actions">
                <button type="submit" class="link">Publish to revision</button>
                <span id="concept-publish-status" class="muted" role="status"></span>
              </p>
            </form>
          </section>
        </div>
      </div>
    </div>
    <script>
      import "../client/app";
      import {setOrganizationLink} from "../../navigation.js";
      setOrganizationLink("workshop");
    </script>

</div>
