---
import AppLayout from "./WorkshopLayout.astro";
import "../styles/workshop.css";
import { projectPath, type SectionId } from "../lib/sections";
import Content from "./Workspace.astro";

interface Props { section: SectionId; slug: string }
const { section, slug } = Astro.props;
const current = {label:section==="parts"?"BOM":section==="release"?"Revisions":"Model"};
---
<AppLayout
  name="Workshop"
  headerStyle="app"
  showOrganizationLink={false}
  introVisuallyHidden
  title={current.label}
  description="Inspect models, parts and product revisions."
  active="home"
  sidebarSections={[
    { label: "Workspace", links: [{ label: "All projects", href: "/", active: false }, { label: "New model", href: "/new", active: false }] },
    { label: "Project", links: [
    ...([{id:"assembly",label:"Model"},{id:"parts",label:"BOM"},{id:"release",label:"Revisions"}] as const).map(s=>({label:s.label,href:projectPath(slug,s.id),active:s.id===section})),
  ] },
  ]}
>
  <Content section={section} slug={slug} />
</AppLayout>
