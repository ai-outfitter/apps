---
import AppLayout from "./WorkshopLayout.astro";
import "../styles/workshop.css";
import { projectPath, type SectionId } from "../lib/sections";
import Content from "./Workspace.astro";
import PCBReview from "./PCBReview.astro";

/** `hasPcb`: the current build carries a PCB review; never set in demo mode. */
interface Props { section: SectionId; slug: string; hasPcb?: boolean }
const { section, slug, hasPcb = false } = Astro.props;
const current = {label:section==="pcb"?"PCB":section==="parts"?"BOM":section==="release"?"Revisions":section==="models"?"Models":"Assembly"};
---
<AppLayout
  name="Workshop"
  headerStyle="app"
  showOrganizationLink={false}
  introVisuallyHidden
  title={current.label}
  description="Inspect models, parts and product revisions."
  active="home"
  sidebarSections={[
    { label: "Workspace", links: [{ label: "All projects", href: "/", active: false }, { label: "New model", href: "/new", active: false }] },
    { label: "Project", links: [
    ...([{id:"pcb",label:"PCB"},{id:"models",label:"Models"},{id:"assembly",label:"Assembly"},{id:"parts",label:"BOM"},{id:"release",label:"Revisions"}] as const).filter(s=>s.id!=="pcb"||hasPcb||section==="pcb").map(s=>({label:s.label,href:projectPath(slug,s.id),active:s.id===section})),
  ] },
  ]}
>
  {section === "pcb" ? <PCBReview slug={slug} /> : <Content section={section} slug={slug} />}
</AppLayout>
