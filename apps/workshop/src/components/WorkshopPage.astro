---
import AppLayout from "./WorkshopLayout.astro";
import "../styles/workshop.css";
import { appHref } from "../app-href";
import { SECTIONS, projectPath, slugId, type SectionId } from "../lib/sections";
import Content from "./Workspace.astro";
import FitTrials from "./FitTrials.astro";
import PCBReview from "./PCBReview.astro";

import { installationDatabase } from "@ai-outfitter/app-sdk/cloudflare/database";
import { projectBySlugId } from "../server/projects";
import { hasPcbReview } from "../lib/pcb-review";

interface Props { section?: SectionId; slug: string }
const { slug } = Astro.props;
let projectName: string | undefined;
let hasPcb = false;
let projectId:string|undefined, revision:number|undefined;
if (import.meta.env.OUTFITTER_APP_MODE !== "demo") {
  try {
    const project = await projectBySlugId(installationDatabase(), slugId(slug)!);
    projectName = project?.name;
    projectId = project?.id;
    revision = project?.revision;
    hasPcb = Boolean(project?.pcbSnapshots?.length) || hasPcbReview(project?.workspace);
  } catch { /* The workspace reports loading errors. */ }
}
const section = Astro.props.section ?? "overview";
const path = (target: string) => appHref(Astro.url.pathname, target);
const defaultView=section==="overview" && !["item","configuration","parameters","revision","build","view"].some(key=>Astro.url.searchParams.has(key));
const preview=projectId && defaultView ? path(`/api/apps/workshop/projects/${projectId}/preview?revision=${revision}&thumbnail=1`) : undefined;
const current = SECTIONS.find(page => page.id === section)!;
const links = SECTIONS.filter(page => !["parts", "power"].includes(page.id) || page.id === section).filter(page => page.id !== "pcb" || hasPcb || section === "pcb").map(page => ({
  label: page.label,
  href: path(projectPath(slug, page.id)),
  active: page.id === section,
}));
---
<AppLayout
  hideReferences={section === "overview"}
  persistKey={`workshop:${slug}:${section}:${Astro.url.search}`}
  name="Workshop"
  headerStyle="app"
  showOrganizationLink={false}
  introVisuallyHidden
  title={current.label}
  description="Inspect models, parts and product revisions."
  active="home"
  sidebarSections={[
    { label: "Workspace", links: [{ label: "All projects", href: path("/"), active: false }, { label: "New model", href: path("/new"), active: false }] },
    { label: projectName ?? "Project", links },
  ]}
>
  {section === "pcb" ? <PCBReview slug={slug} /> : <Content section={section} slug={slug} projectId={projectId} preview={preview} />}
  {section === "release" && projectId && <FitTrials db={installationDatabase()} projectId={projectId} />}
</AppLayout>
