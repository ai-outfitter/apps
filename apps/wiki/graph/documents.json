  {
    "name": "DailyAppUpdates",
    "kind": "query",
    "story": "As a member, I want the app updates saved for a local calendar date across my Wikis, so that my personal brief can cite each reporting timezone and exact revision.",
    "query": "query DailyAppUpdates($date: String!, $first: Int = 50, $after: String) {\n  dailyAppUpdates(date: $date, first: $first, after: $after) {\n    nodes {\n      id\n      slug\n      app\n      summary\n      complete\n      revision\n      timezone\n    }\n    pageInfo {\n      endCursor\n      hasNextPage\n    }\n  }\n}",
    "hash": "2c0188e688b99f9af2db3c603016297f3b4fa2d2ca8f7bd89c32b39ceaf915a2",
