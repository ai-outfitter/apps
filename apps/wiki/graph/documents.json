        },
        "first": {
          "type": "integer",
          "description": "GraphQL Int"
        },
        "after": {
          "type": "string",
          "description": "GraphQL String"
        }
      },
      "required": [
        "date"
      ]
    },
    "mcp": {
      "description": "Read dated app summaries and their Wiki revisions across authorized personal and organization scopes.",
      "collection": true
    },
    "federation": {
      "collection": "dailyAppUpdates",
      "cursorVariable": "after"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "dailyAppUpdates": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "nullable": true
                  },
                  "slug": {
                    "type": "string",
                    "nullable": true
                  },
                  "app": {
                    "type": "string",
                    "nullable": true
                  },
                  "summary": {
                    "type": "string",
                    "nullable": true
                  },
                  "complete": {
                    "type": "boolean",
                    "nullable": true
                  },
                  "revision": {
                    "type": "integer",
                    "nullable": true
                  },
                  "timezone": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            },
            "pageInfo": {
              "type": "object",
              "properties": {
                "endCursor": {
                  "type": "string",
                  "nullable": true
                },
                "hasNextPage": {
