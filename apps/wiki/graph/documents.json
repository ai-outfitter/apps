  {
    "name": "WikiDocuments",
    "kind": "query",
    "story": "As a member, I want to search several topics or read several document slugs together, so that I can find and cite the relevant revisions in one request.",
    "query": "query WikiDocuments($refs: [String!], $search: [String!], $revision: Int, $after: String, $first: Int = 20, $includeBody: Boolean = false) {\n  searchDocuments(\n    refs: $refs\n    search: $search\n    revision: $revision\n    after: $after\n    first: $first\n    includeBody: $includeBody\n  ) {\n    documents {\n      slug\n      id\n      title\n      summary\n      revision\n      publishedRevision\n      body @include(if: $includeBody)\n      generatedBody @include(if: $includeBody)\n    }\n    next\n  }\n}",
    "hash": "4e74c13af84822066909ce2a7f02c623f1e23a4a6a2c199cd86d3d153c07282b",
    "variables": {
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "description": "GraphQL [String!]"
        },
        "search": {
          "type": "array",
          "description": "GraphQL [String!]"
        },
        "revision": {
          "type": "integer",
          "description": "GraphQL Int"
        },
        "after": {
          "type": "string",
          "description": "GraphQL String"
        },
        "first": {
          "type": "integer",
          "description": "GraphQL Int"
        },
        "includeBody": {
          "type": "boolean",
          "description": "GraphQL Boolean"
        }
      },
      "required": []
    },
    "mcp": {
      "description": "Start here for Wiki documents. Batch related search phrases in search (matches any), or pass all known slugs together in refs; document IDs also work. Prefer slugs when citing or reading again. Set includeBody:true when you need content. Omit revision for current drafts. For more results pass next as after."
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "searchDocuments": {
          "type": "object",
          "properties": {
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "nullable": true
                  },
                  "id": {
                    "type": "string",
                    "nullable": true
                  },
                  "title": {
                    "type": "string",
                    "nullable": true
                  },
                  "summary": {
                    "type": "string",
                    "nullable": true
                  },
                  "revision": {
                    "type": "integer",
                    "nullable": true
                  },
                  "publishedRevision": {
                    "type": "integer",
                    "nullable": true
                  },
                  "body": {
                    "type": "string",
                    "nullable": true
                  },
                  "generatedBody": {
                    "type": "string",
                    "nullable": true
                  }
                }
              },
              "nullable": true
            },
            "next": {
              "type": "string",
              "nullable": true
            }
          },
          "nullable": true
        }
      }
    }
