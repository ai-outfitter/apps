---
import {mount} from "../documents/context";
import {agentDatabase} from "@ai-outfitter/app-sdk/cloudflare/database";
const segments=(Astro.params.legacy ?? "").split("/");
const root=mount(Astro.request);
if(segments[0]==="api")return new Response("Legacy graph operations moved to Onto",{status:410});
if(["document","documents"].includes(segments[0])&&!segments[1])return Astro.redirect(root,302);
const legacyId=segments[1] ?? Astro.url.searchParams.get("node") ?? Astro.url.searchParams.get("slug");
if(import.meta.env.OUTFITTER_APP_MODE==="operational"&&legacyId){
 const pages=await agentDatabase().query({sql:"SELECT slug FROM wiki_pages WHERE documentId=? OR slug=? LIMIT 1",params:[legacyId,legacyId]});
 if(pages[0])return Astro.redirect(`${root}p/${encodeURIComponent(String(pages[0].slug))}`,302);
}
return Astro.redirect(`${root.replace(/wiki-map\/$/,"onto/")}${segments.map(encodeURIComponent).join("/")}${Astro.url.search}`,302);
---
