    "query": "query DailyShipped($since: DateTime!, $until: DateTime, $repositories: [String!]) {\n  changes(since: $since, until: $until, repositories: $repositories) {\n    changes {\n      repository\n      number\n      title\n      url\n      mergedAt\n      author\n      mergeCommit\n      kind\n      areas\n    }\n    failed\n    complete\n  }\n}",
