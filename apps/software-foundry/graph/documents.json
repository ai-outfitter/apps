  {
    "name": "DailyShipped",
    "kind": "query",
    "story": "As a stakeholder or their agent, I want every pull request merged in a window (yesterday, by default a day) with its kind and the parts of the repository it touched, so that I can read or write a daily report of what shipped.",
    "query": "query DailyShipped($since: DateTime!, $until: DateTime, $repositories: [String!]) {\n  changes(since: $since, until: $until, repositories: $repositories) {\n    changes {\n      repository\n      number\n      title\n      url\n      mergedAt\n      author\n      mergeCommit\n      kind\n      areas\n    }\n    failed\n    complete\n  }\n}",
    "hash": "dd4e453a29603f9e9f95febe252054d71f5cdd7e34272a9dbb8a43203e77ed3b",
    "variables": {
      "type": "object",
      "properties": {
        "since": {
          "description": "GraphQL DateTime!"
        },
        "until": {
          "description": "GraphQL DateTime"
        },
        "repositories": {
          "type": "array",
          "description": "GraphQL [String!]"
        }
      },
      "required": [
        "since"
      ]
    },
    "hidden": true
  },
  {
