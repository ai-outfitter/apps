  {
    "name": "RepositoryChanges",
    "kind": "mutation",
    "story": "As an authorized caller, I want to turn Foundry execution on for a repository, so that each change has a durable receipt and explicit next steps.",
    "query": "mutation RepositoryChanges($input: RepositoryChangesInput!) {\n  repositoryChanges(input: $input) {\n    items {\n      key\n      status\n      result\n      error\n    }\n    instructions {\n      code\n      itemKey\n      actor\n      required\n      message\n      call\n      taskId\n      url\n    }\n  }\n}",
    "hash": "201aa6e77e84b40b876091b33ee5fefaa498609c60ed4ef6d79058185fe98e48",
    "variables": {
      "type": "object",
      "properties": {
        "input": {
          "description": "GraphQL RepositoryChangesInput!"
        }
      },
      "required": [
        "input"
      ]
    },
    "mcp": {
      "description": "Turn Foundry execution on for a repository (action enable, input {repository}): approves Foundry's role agents and subscribes to the repository's issues, so RequestChanges there starts work instead of answering that execution is not configured. Repeat to refresh after a Foundry change. Owners and admins only; use a new item key each time."
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "input": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "items": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "description": "Your stable key for this item: any short name, such as add-ada. Reuse it only to retry the same input."
                      },
                      "action": {
                        "type": "string",
                        "const": "enable"
                      },
                      "input": {
                        "type": "object",
                        "properties": {
                          "repository": {
                            "type": "string",
                            "maxLength": 140,
                            "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$",
                            "description": "owner/name, reachable through this organization's GitHub connection."
                          },
                          "reviewer": {
                            "default": "vega",
                            "description": "The workspace's independent reviewer.",
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        },
                        "required": [
                          "repository"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "key",
                      "action",
                      "input"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "repositoryChanges": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "result": {
                    "description": "JSON",
                    "nullable": true
                  },
                  "error": {
                    "description": "JSON",
                    "nullable": true
                  }
                }
              }
            },
            "instructions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "itemKey": {
                    "type": "string"
                  },
                  "actor": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string"
                  },
                  "call": {
                    "description": "JSON",
