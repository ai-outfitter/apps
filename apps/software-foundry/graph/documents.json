  {
    "name": "ReviewIssue",
    "kind": "mutation",
    "story": "As an organization editor, I want to start, recover or restart a review of an existing issue at a pinned base, so that I can assess an independently reviewed draft.",
    "query": "mutation ReviewIssue($input: ReviewIssueInput!) {\n  reviewIssue(input: $input)\n}",
    "hash": "87cae3836f8ce0ea9a8d8a5aea0089a3e60dd905cf11ae330e729ab5fdfb441b",
    "variables": {
      "type": "object",
      "properties": {
        "input": {
          "description": "GraphQL ReviewIssueInput!"
        }
      },
      "required": [
        "input"
      ]
    },
    "mcp": {
      "description": "START reviews an existing open issue. Supply provider (FORGEJO or GITHUB), repository (owner/name), numeric repositoryId, issueNumber, baseRef and exact baseSha. RECOVER takes only the original runId and requires a retained checkout initialization failure, current repository approval, and the original initiator. RESTART takes a failed runId and a caller-generated requestId to capture the current title and body after a proven pre-checkout failure. The first claim fixes that snapshot. Continuations preserve the issue identity, exact base and approved actors. Repeat RESTART with the same requestId to get that request’s continuation. Use IssueReview to read progress and the local draft and formal review."
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "input": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,99}\\/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
                },
                "repositoryId": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "issueNumber": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "baseRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
                },
                "baseSha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "action": {
                  "type": "string",
                  "const": "START"
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "FORGEJO",
                    "GITHUB"
                  ]
                }
              },
              "required": [
                "repository",
                "repositoryId",
                "issueNumber",
                "baseRef",
                "baseSha",
                "action",
                "provider"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "RECOVER"
                },
                "runId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "required": [
                "action",
                "runId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "RESTART"
                },
                "runId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "requestId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "required": [
                "action",
                "runId",
                "requestId"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "reviewIssue": {
          "description": "JSON"
        }
      }
    }
  },
