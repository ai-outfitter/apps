  {
    "name": "RequestChanges",
    "kind": "mutation",
    "story": "As an authorized caller, I want to file feature and bug requests: each opens a GitHub issue and starts Foundry's workflow, so that each change has a durable receipt and explicit next steps.",
    "query": "mutation RequestChanges($input: RequestChangesInput!) {\n  requestChanges(input: $input) {\n    items {\n      key\n      status\n      result\n      error\n    }\n    instructions {\n      code\n      itemKey\n      actor\n      required\n      message\n      call\n      taskId\n      url\n    }\n  }\n}",
    "hash": "1fb063f32191be89f299dcc2414f7b24edafb2b7759cf907e6d3c242ff9309e4",
    "variables": {
      "type": "object",
      "properties": {
        "input": {
          "description": "GraphQL RequestChangesInput!"
        }
      },
      "required": [
        "input"
      ]
    },
    "mcp": {
      "description": "File feature or bug requests (kind, title, problem, acceptance criteria with ids, and bug details for bugs; strict JSON Schema, the same work request the Foundry box reads). Each opens a GitHub issue in the named repository or Foundry project and starts Foundry's issue-to-merge workflow. Returns the issue and run; if execution is unavailable the issue is still recorded with execution details. Retry with the same requestId; use a new item key. Action resume {requestId, resumeId} starts a request's failed or awaiting-details run again on the same issue."
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "input": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "items": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "description": "Your stable key for this item: any short name, such as add-ada. Reuse it only to retry the same input."
                      },
                      "action": {
                        "type": "string",
                        "const": "submit"
                      },
                      "input": {
                        "type": "object",
                        "properties": {
                          "requestId": {
                            "description": "Caller-generated ID. Reuse it to retry an identical request; changed content conflicts.",
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "feature",
                              "bug"
                            ],
                            "description": "feature: new or changed behavior. bug: existing behavior that is wrong; needs bug details."
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "problem": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 20000
                          },
                          "acceptanceCriteria": {
                            "minItems": 1,
                            "maxItems": 50,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                                },
                                "text": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2000
                                }
                              },
                              "required": [
                                "id",
                                "text"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "bug": {
                            "type": "object",
                            "properties": {
                              "stepsToReproduce": {
                                "minItems": 1,
                                "maxItems": 50,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "expected": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              },
                              "actual": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              },
                              "environment": {
                                "type": "string",
                                "maxLength": 2000
                              }
                            },
                            "required": [
                              "stepsToReproduce",
                              "expected",
                              "actual"
                            ],
                            "additionalProperties": false
                          },
                          "target": {
                            "type": "object",
                            "properties": {
                              "repository": {
                                "type": "string",
                                "maxLength": 140,
                                "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
                              },
                              "project": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              }
                            },
                            "additionalProperties": false
                          },
                          "context": {
                            "default": [],
                            "description": "Records the request relies on (stories, requirements, goals). Rendered as references; not resolved.",
                            "maxItems": 32,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "installationId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128,
                                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                                },
                                "type": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128,
                                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                                },
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128,
                                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                                },
                                "title": {
                                  "type": "string",
                                  "maxLength": 200
                                }
                              },
                              "required": [
                                "installationId",
                                "type",
                                "id"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "requestId",
                          "kind",
                          "title",
                          "problem",
                          "acceptanceCriteria",
                          "target"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "key",
                      "action",
                      "input"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                        "description": "Your stable key for this item: any short name, such as add-ada. Reuse it only to retry the same input."
                      },
                      "action": {
                        "type": "string",
                        "const": "resume"
                      },
                      "input": {
                        "type": "object",
                        "properties": {
                          "requestId": {
                            "description": "The request whose stopped run to start again.",
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "resumeId": {
                            "description": "Caller-generated ID for this restart. Reuse it to retry the same restart; a new one restarts again.",
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          }
                        },
                        "required": [
                          "requestId",
                          "resumeId"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "key",
                      "action",
                      "input"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "requestChanges": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "result": {
                    "description": "JSON",
                    "nullable": true
                  },
                  "error": {
                    "description": "JSON",
                    "nullable": true
                  }
                }
              }
            },
            "instructions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "itemKey": {
                    "type": "string"
                  },
                  "actor": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string"
                  },
                  "call": {
                    "description": "JSON",
                    "nullable": true
                  },
                  "taskId": {
                    "type": "string",
                    "nullable": true
                  },
                  "url": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          },
          "nullable": true
        }
      }
    }
  },
