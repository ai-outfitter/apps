{
  "$id": "https://outfitter.ai/schemas/foundry-box/run-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "landed",
        "needs_details",
        "changes_requested",
        "failed",
        "refused"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 4000
    },
    "issue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "number",
        "url"
      ],
      "additionalProperties": false
    },
    "triage": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "plan",
        "questions"
      ],
      "additionalProperties": false
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "delivery": {
              "type": "string",
              "const": "pull_request"
            },
            "pullRequest": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "feature",
                        "bug"
                      ]
                    },
                    "issueNumber": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "requestId",
                    "kind",
                    "issueNumber"
                  ],
                  "additionalProperties": false
                },
                "baseBranch": {
                  "type": "string",
                  "minLength": 1
                },
                "baseSha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "headBranch": {
                  "type": "string",
                  "minLength": 1
                },
                "headSha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "changes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "change": {
                        "type": "string",
                        "enum": [
                          "added",
                          "modified",
                          "deleted",
                          "renamed"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "path",
                      "change",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                },
                "acceptanceCriteria": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "met",
                          "not_met",
                          "unverified"
                        ]
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "screenshot",
                                "log",
                                "report",
                                "artifact"
                              ]
                            },
                            "uri": {
                              "type": "string",
                              "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "criterionId": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                            },
                            "viewport": {
                              "type": "string",
                              "enum": [
                                "desktop",
                                "mobile"
                              ]
                            },
                            "commitSha": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{40}$"
                            }
                          },
                          "required": [
                            "kind",
                            "uri",
                            "sha256",
                            "commitSha"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "status",
                      "evidence"
                    ],
                    "additionalProperties": false
                  }
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "conclusion": {
                        "type": "string",
                        "enum": [
                          "success",
                          "failure",
                          "cancelled",
                          "skipped"
                        ]
                      },
                      "commitSha": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      },
                      "logUri": {
                        "type": "string",
                        "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
                      }
                    },
                    "required": [
                      "name",
                      "command",
                      "conclusion",
                      "commitSha"
                    ],
                    "additionalProperties": false
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "screenshot",
                          "log",
                          "report",
                          "artifact"
                        ]
                      },
                      "uri": {
                        "type": "string",
                        "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "criterionId": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                      },
                      "viewport": {
                        "type": "string",
                        "enum": [
                          "desktop",
                          "mobile"
                        ]
                      },
                      "commitSha": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      }
                    },
                    "required": [
                      "kind",
                      "uri",
                      "sha256",
                      "commitSha"
                    ],
                    "additionalProperties": false
                  }
                },
                "risks": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "limitations": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "review": {
                  "type": "object",
                  "properties": {
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "approved",
                        "changes_requested"
                      ]
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commitSha": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "verdict",
                    "reviewer",
                    "commitSha"
                  ],
                  "additionalProperties": false
                },
                "draft": {
                  "type": "boolean"
                }
              },
              "required": [
                "schemaVersion",
                "number",
                "url",
                "title",
                "request",
                "baseBranch",
                "baseSha",
                "headBranch",
                "headSha",
                "summary",
                "changes",
                "acceptanceCriteria",
                "tests",
                "evidence",
                "draft"
              ],
              "additionalProperties": false
            },
            "mergeSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "delivery",
            "pullRequest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "delivery": {
              "type": "string",
              "const": "direct_commit"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "commits": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "required": [
            "delivery",
            "branch",
            "commits"
          ],
          "additionalProperties": false
        }
      ]
    },
    "checks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "cancelled",
              "skipped"
            ]
          },
          "commitSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "logUri": {
            "type": "string",
            "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
          }
        },
        "required": [
          "name",
          "command",
          "conclusion",
          "commitSha"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "verdict",
        "reviewer",
        "commitSha"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "artifacts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "uri",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "evidenceBundle": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "uri",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tag",
        "url",
        "artifacts",
        "evidenceBundle"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "luna",
            "spark",
            "replay"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "inputTokens",
        "outputTokens"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "modelSeconds": {
          "type": "number",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokensPerSecond": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "modelCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "inputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "status",
              "seconds",
              "modelCalls",
              "inputTokens",
              "outputTokens"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "wallSeconds",
        "modelSeconds",
        "modelCalls",
        "inputTokens",
        "outputTokens",
        "outputTokensPerSecond",
        "steps"
      ],
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "agent",
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "issue",
    "model",
    "startedAt",
    "finishedAt"
  ],
  "additionalProperties": false
}
