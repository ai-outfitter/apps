{
  "$id": "https://outfitter.ai/schemas/foundry-box/pull-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "request": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "feature",
            "bug"
          ]
        },
        "issueNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "kind",
        "issueNumber"
      ],
      "additionalProperties": false
    },
    "baseBranch": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "headBranch": {
      "type": "string",
      "minLength": 1
    },
    "headSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "enum": [
              "added",
              "modified",
              "deleted",
              "renamed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "path",
          "change",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "acceptanceCriteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "not_met",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "screenshot",
                    "log",
                    "report",
                    "artifact"
                  ]
                },
                "uri": {
                  "type": "string",
                  "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "criterionId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "viewport": {
                  "type": "string",
                  "enum": [
                    "desktop",
                    "mobile"
                  ]
                },
                "commitSha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "kind",
                "uri",
                "sha256",
                "commitSha"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "cancelled",
              "skipped"
            ]
          },
          "commitSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "logUri": {
            "type": "string",
            "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
          }
        },
        "required": [
          "name",
          "command",
          "conclusion",
          "commitSha"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "screenshot",
              "log",
              "report",
              "artifact"
            ]
          },
          "uri": {
            "type": "string",
            "pattern": "^s3:\\/\\/[a-z0-9.-]+\\/.+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "criterionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "viewport": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "commitSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "required": [
          "kind",
          "uri",
          "sha256",
          "commitSha"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "verdict",
        "reviewer",
        "commitSha"
      ],
      "additionalProperties": false
    },
    "draft": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "number",
    "url",
    "title",
    "request",
    "baseBranch",
    "baseSha",
    "headBranch",
    "headSha",
    "summary",
    "changes",
    "acceptanceCriteria",
    "tests",
    "evidence",
    "draft"
  ],
  "additionalProperties": false
}
