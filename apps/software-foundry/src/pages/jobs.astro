---
import "../styles.css";
import AppLayout from "../components/FoundryLayout.astro";
import Section from "@ai-outfitter/ui/astro/Section.astro";
import Table from "@ai-outfitter/ui/astro/Table.astro";
// Repository jobs: an agent reads a repository and files ranked issues. They never
// change code; on a repository Foundry is enabled for, each filed issue starts
// issue to merge, which opens the pull request.
const jobs = [
  {
    id: "dependency-review",
    title: "Dependency review",
    summary:
      "Dependabot-style, but judged by an agent: what is out of date, what is no longer needed, and what has a better option. One issue per proposed change.",
    cadence: "every Monday at 14:00 UTC",
  },
  {
    id: "architecture-reanalysis",
    title: "Architecture reanalysis (ARR)",
    summary:
      "Rereads the repository as it is now and files ranked refactor issues for the structure fast shipping left behind, each with evidence and an incremental plan.",
    cadence: "on the 1st of each month at 14:00 UTC",
  },
  {
    id: "ui-review",
    title: "UI review",
    summary:
      "Opens every page at phone and desktop size, checks it against the UI standards and files one fix per issue. Each fix's pull request shows before and after screenshots in its Demo.",
    cadence: "every Wednesday at 14:00 UTC",
  },
];
---
<AppLayout title="Jobs" description="Run repository jobs that file issues for the work worth doing." active="home">
  <div class="feed-toolbar">
    <label for="job-repository">Repository <select id="job-repository" disabled><option>Loading repositories…</option></select></label>
  </div>
  <p id="job-notice" role="status" aria-live="polite">Loading available repositories…</p>
  {jobs.map((job) => (
    <Section id={`job-${job.id}`} title={job.title}>
      <button slot="actions" class="secondary" data-job={job.id} disabled>Run now</button>
      <button slot="actions" class="secondary" data-schedule={job.id} disabled>Schedule</button>
      <p>{job.summary}</p>
      <p>Scheduled runs start {job.cadence} as the person who saved the schedule. If they can no longer run it, it pauses with the reason until an admin saves it again.</p>
      <ul id={`job-schedules-${job.id}`} class="job-schedules"></ul>
      <Table id={`job-runs-${job.id}`} label={`${job.title} runs`} columns={["Started", "Repository", "Status", "Issues filed"]} />
      <p id={`job-empty-${job.id}`} role="status">No runs yet.</p>
    </Section>
  ))}
</AppLayout>
<script>import "../scripts/jobs.js";</script>
