{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "astro/client",
      "@cloudflare/workers-types"
    ],
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schemas": [
          {
            "name": "standard",
            "schema": "./graph/standard-schema.graphql",
            "tadaOutputLocation": "./graph/standard-env.d.ts"
          }
        ]
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "graph/*.d.ts"
  ]
}
