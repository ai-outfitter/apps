---
import {typeIds} from './index';
interface Props { records: any[] }
const {records}=Astro.props;
const safe=(uri:unknown)=>typeof uri==='string'&&/^https:\/\//.test(uri)?uri:undefined;
const kind=(record:any)=>Object.entries(typeIds).find(([,id])=>id===record.typeId)?.[0]??'Record';
const feedbackRecords=records.filter(r=>r.typeId===typeIds.CreativeFeedback);
const labels:Record<string,string>={CreativeBrief:'Brief',PromptFragment:'Prompt fragment',Storyboard:'Storyboard',GenerationSnapshot:'Frozen inputs',CreativeCandidate:'Candidate',CreativeSelection:'Selection',CreativeFeedback:'Feedback'};
const nameFor=(ref:any)=>records.find(r=>r.id===ref?.id)?.title??ref?.id??'Unavailable reference';
const selections=records.filter(r=>r.typeId===typeIds.CreativeSelection);
---
{records.length===0&&<p>No creative records yet. Ask your agent to start from a product or revision.</p>}
<div class="creative-records">{records.map(record=>{
 const body=record.body;const type=kind(record);const uri=safe(body.artifact?.uri);
 return <article id={record.id}>
 <p class="kind">{labels[type]??type} · revision {record.revision}</p><h2>{record.title}</h2>
 {type==='CreativeBrief'&&<><p>{body.purpose}</p><p>Audience: {body.audience}</p><ul>{body.constraints?.map((text:string)=><li>{text}</li>)}</ul></>}
 {type==='PromptFragment'&&<pre>{body.text}</pre>}
 {type==='Storyboard'&&<ol>{body.items?.map((item:any)=><li><h3>{item.title}</h3><p>{item.narrative}</p>{item.prompt&&<p>Prompt {item.prompt.id} · revision {item.prompt.revision}</p>}</li>)}</ol>}
 {type==='GenerationSnapshot'&&<details><summary>Frozen generation inputs</summary><pre>{body.text}</pre><p>{body.hash}</p></details>}
 {type==='CreativeCandidate'&&<><p>{body.concept?'Concept / appearance reference':'Recorded output'} · {record.drift?.state??'unknown'}</p>{record.drift?.changed?.length>0&&<p>Changed: {record.drift.changed.join(', ')}</p>}{record.drift?.reason&&<p>{record.drift.reason}</p>}{uri&&body.mediaType?.startsWith('image/')&&<img src={uri} alt={record.title} loading="lazy"/>}{uri&&body.mediaType==='video/mp4'&&<video src={uri} controls preload="metadata"/>}{uri&&<a href={uri} rel="noreferrer">View or download artifact</a>}<details><summary>Artifact fingerprint</summary><p>{body.artifact?.contentHash??"Not recorded"}</p></details>{selections.filter(s=>s.body.candidate?.id===record.id).map(s=><p>Selected for {s.body.slot}</p>)}{[...(body.feedback??[]),...feedbackRecords.filter(f=>f.body.candidate?.id===record.id).map(f=>f.body)].map((f:any)=><blockquote>{f.text}<footer>{f.author} · {f.at}</footer></blockquote>)}</>}
 {type==='CreativeFeedback'&&<blockquote>{body.text}<footer>{body.author} · {body.at}</footer></blockquote>}
 {type==='CreativeSelection'&&<p>Selected {nameFor(body.candidate)} (revision {body.candidate?.revision}) for {body.slot}. Selection preserves this revision and does not approve manufacture.</p>}
 </article>;
})}</div>
<style>.creative-records{display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}article{padding:1.3rem;border:1px solid #8885;border-radius:10px;overflow-wrap:anywhere}img,video{max-width:100%;max-height:360px;object-fit:contain}pre{white-space:pre-wrap;font:inherit}.kind{font-size:.85rem;opacity:.7}blockquote{margin:1rem 0;padding-left:1rem;border-left:2px solid #8885}</style>
