---
import { iconPaths, type IconName } from "../icons";
interface Props { name: IconName; size?: number | string }
const { name, size = 20 } = Astro.props;
---
<svg aria-hidden="true" focusable="false" class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={iconPaths[name]} /></svg>
