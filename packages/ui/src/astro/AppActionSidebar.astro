---
import AppAgentSidebar from "@ai-outfitter/ui/react/AppAgentSidebar";
import { requestUiPreferences } from "@ai-outfitter/app-sdk/ui-preferences";
interface Props { app: string; label: string; focusId: string; conversationNavigation?: boolean; }
const { app, label, focusId, conversationNavigation = false } = Astro.props;
const demo = import.meta.env.OUTFITTER_APP_MODE === "demo";
// Open on arrival when the member left it open (the outfitter-ui cookie).
const initialOpen = requestUiPreferences(Astro.request).agent === `${app}-agent`;
---
<span hidden data-action-agent={app} data-focus-id={focusId} data-agent-label={label}></span>
<AppAgentSidebar client:idle agentName={label} id={`${app}-agent`} {initialOpen} pageId={app} endpoint={`/api/apps/${app}/agent`} {demo} {conversationNavigation}
  intro={`Ask about ${label} and review proposed changes before applying them.`}
  emptyIntro={`Ask about the saved records available in ${label}.`}
  limits={demo ? "Read-only demo. Replies are scripted; records cannot change." : "Uses the app's authorized saved records. Proposed actions require your review and current permission."}
  demoReply="This is a read-only example. No inference ran and no records changed." />
<script>
 import { agentPage } from "@ai-outfitter/app-sdk/agent-context";
 for (const node of document.querySelectorAll<HTMLElement>("[data-action-agent]")) {
  const app = node.dataset.actionAgent!, id = node.dataset.focusId!;
  agentPage(app).set({ focus: { kind: app, id, label: node.dataset.agentLabel ?? app } });
 }
</script>
