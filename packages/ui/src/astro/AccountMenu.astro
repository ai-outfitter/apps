---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";

// The platform account menu, shared by managed apps and their personal rail.
// Without `user`, the script reads the signed-in account from `/api/whoami`.
interface Props {
  user?: { id: string; name: string; email: string };
  /** Where the platform's account routes live; the page's own origin by default. */
  platformOrigin?: string;
  /** False lists no other accounts (a demo's fixture member has none). */
  accounts?: boolean;
  /** Optional app entries retained for existing consumers; managed layouts show these in their settings menu. */
  appLinks?: { label: string; href: string; icon?: IconName; active?: boolean }[];
}
const { user, platformOrigin, accounts = true, appLinks = [] } = Astro.props;
const label = user ? user.name || user.email : "";
const initial = label.slice(0, 1).toUpperCase() || "O";
---
<div class="sidebar-footer" data-account-footer data-user-id={user?.id ?? ""} data-provided-user={String(Boolean(user))} data-platform-origin={platformOrigin} data-accounts={String(accounts)} hidden={!user}>
  <div id="account-menu" class="account-menu" hidden>
    <div class="account-option current" aria-current="true"><span class="avatar" data-account-initial>{initial}</span><span><strong data-account-name>{label}</strong><small data-account-email>{user?.email}</small></span><Icon name="check" size={16} /></div>
    {accounts && <a class="account-option" href="/accounts" data-account-link="/accounts" data-astro-reload>Manage accounts</a>}
    <hr class="account-divider" />
    {appLinks.length > 0 && <>
      <nav class="ui-navigation account-app-links" aria-label="App account links">
        {appLinks.map((link) => <a class="account-option" href={link.href} aria-current={link.active ? "page" : undefined}><span class="avatar"><Icon name={link.icon ?? "settings"} size={16} /></span><span>{link.label}</span></a>)}
      </nav>
      <hr class="account-divider" />
    </>}
    <a class="account-option" href="/profile" data-account-link="/profile" data-astro-reload><span class="avatar"><Icon name="compass" size={16} /></span><span>Profile</span></a>
    <a class="account-option" href="/settings" data-account-link="/settings" data-astro-reload><span class="avatar"><Icon name="spark" size={16} /></span><span>Settings</span></a>
    <a class="account-option" href="/organizations" data-account-link="/organizations" data-astro-reload><span class="avatar"><Icon name="organization" size={16} /></span><span>Teams</span></a>
    <a class="account-option" href="/install" data-account-link="/install" data-astro-reload><span class="avatar"><Icon name="plus" size={16} /></span><span>Install Apps</span></a>
    <a class="account-option" href="/help" data-account-link="/help" data-astro-reload><span class="avatar"><Icon name="spark" size={16} /></span><span>Help</span></a>

  </div>
  <button class="account-toggle" aria-expanded="false" aria-controls="account-menu" aria-label="Accounts" data-disclosure="">
    <span class="avatar" data-account-initial>{initial}</span><span><strong data-account-name>{label}</strong><small data-account-email>{user?.email}</small></span>
  </button>
</div>
<script>
  import { installAccountMenu } from "../scripts/account-menu";
  installAccountMenu();
</script>
