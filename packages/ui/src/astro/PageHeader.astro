---
interface Props {
  title: string;
  description?: string;
  visuallyHidden?: boolean;
}
const { title, description, visuallyHidden = false } = Astro.props;
---
<div class:list={["intro", { "visually-hidden": visuallyHidden }]}>
  <div class="intro-heading"><h1>{title}</h1><slot name="actions" /></div>
  {description && <p>{description}</p>}
</div>
